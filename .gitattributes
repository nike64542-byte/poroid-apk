* text=auto
*.sh        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Dockerfile* text eol=lf
Makefile*   text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.properties text eol=lf
# Binary assets — never convert
*.squashfs filter=lfs diff=lfs merge=lfs -text
*.img           binary
*.so            binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.apk           binary
*.jks           binary
*.keystore      binary
*.zip           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.zst           binary
vmlinuz-virt filter=lfs diff=lfs merge=lfs -text
initrd.img filter=lfs diff=lfs merge=lfs -text
